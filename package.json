{
  "name": "screen-record-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "brand:icons": "bash brand/generate-icons.sh",
    "dev:desktop": "npm run dev -w screen-record",
    "dev:web": "npm run dev -w screen-record-web",
    "build": "npm run build -w screen-record && npm run build -w screen-record-web",
    "build:desktop": "npm run build -w screen-record",
    "build:web": "npm run build -w screen-record-web",
    "lint": "npm run lint -w screen-record-web",
    "db:generate": "npm run db:generate -w screen-record-web",
    "test": "npm run test -w screen-record-web",
    "test:unit": "npm run test:unit -w screen-record-web",
    "test:integration": "npm run test:integration -w screen-record-web",
    "test:desktop": "npm run test -w screen-record",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v"
  }
}
